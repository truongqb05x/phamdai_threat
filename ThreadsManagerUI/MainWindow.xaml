<Window x:Class="ThreadsManagerUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ThreadsManagerUI"
        mc:Ignorable="d"
        Title="Phần mềm quản lý tài khoản Threads" Height="700" Width="1200" WindowStartupLocation="CenterScreen" Icon="logo.jpg">
    
    <Grid Background="#F5F6F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header/Tabs -->
            <RowDefinition Height="Auto"/> <!-- Sub Header / Filter -->
            <RowDefinition Height="*"/>    <!-- Main Content -->
        </Grid.RowDefinitions>

        <!-- Top Menu / Tabs -->
        <Border Grid.Row="0" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Background="White">
            <StackPanel Orientation="Horizontal" Margin="10,5">
                <Button Content="Kết Nối Threads" Padding="15,8" Background="#1877F2" Foreground="White" BorderThickness="0" Margin="0,0,5,0" FontWeight="Bold"/>
                <Button Content="Đăng Bài (Post)" Padding="15,8" Background="Transparent" BorderThickness="0" Margin="0,0,5,0"/>
                <Button Content="Nuôi Tài Khoản" Padding="15,8" Background="Transparent" BorderThickness="0" Margin="0,0,5,0"/>
                <Button Content="Cấu Hình Hệ Thống" Padding="15,8" Background="Transparent" BorderThickness="0"/>
            </StackPanel>
        </Border>

        <!-- Toolbar / Filter -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Lọc:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="CboStatusFilter" Width="120" Margin="0,0,10,0" SelectedIndex="0" SelectionChanged="CboStatusFilter_SelectionChanged">
                    <ComboBoxItem Content="All Status"/>
                    <ComboBoxItem Content="Live"/>
                    <ComboBoxItem Content="Dead"/>
                </ComboBox>
                
                <ComboBox Width="120" Margin="0,0,10,0" SelectedIndex="0">
                    <ComboBoxItem Content="All Folder"/>
                </ComboBox>
                
                <TextBlock Text="Tìm kiếm:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                <TextBox x:Name="TxtSearch" Width="200" VerticalContentAlignment="Center" Margin="0,0,10,0" TextChanged="TxtSearch_TextChanged"/>
                <Button Content="Tìm" Padding="15,5" Margin="0,0,10,0" Click="BtnSearch_Click"/>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Trạng thái chọn -->
            <TextBlock x:Name="TxtSelectedCount" Grid.Row="0" Grid.Column="0" Text="Đã chọn: 0" FontWeight="Bold" Margin="0,0,0,5" Foreground="#333"/>

            <!-- DataGrid -->
            <DataGrid x:Name="DgAccounts" Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Accounts}" AutoGenerateColumns="False" CanUserAddRows="False" Background="White" GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderBrush="#E0E0E0" VerticalGridLinesBrush="#EEEEEE" HorizontalGridLinesBrush="#EEEEEE" SelectionChanged="DgAccounts_SelectionChanged">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy" Click="MenuItem_Copy_Click"/>
                        <MenuItem Header="Mở Chrome" Click="MenuItem_OpenChrome_Click"/>
                        <MenuItem Header="Xóa" Click="MenuItem_Delete_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <Setter Property="Background" Value="White"/> 
                        <Setter Property="Foreground" Value="Black"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Live">
                                <Setter Property="Background" Value="#E6F4EA"/> <!-- Xanh lá nhạt (giống hình) -->
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Dead">
                                <Setter Property="Background" Value="#FCE8E6"/> <!-- Đỏ nhạt -->
                            </DataTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#0078D7"/> <!-- Xanh da trời đậm giống Windows -->
                                <Setter Property="Foreground" Value="White"/>   <!-- Đổi chữ thành màu trắng để dễ đọc -->
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" Value="#F5F5F5"/> <!-- Màu hover khi không chọn -->
                            </MultiTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F5F6F8"/>
                        <Setter Property="Foreground" Value="#666666"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,12"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="BorderBrush" Value="#E0E0E0"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="5,5"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="Transparent" SnapsToDevicePixels="True">
                                        <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Chọn" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="50">
                        <DataGridCheckBoxColumn.ElementStyle>
                            <Style TargetType="CheckBox">
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                <Setter Property="Margin" Value="10,0,0,0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridCheckBoxColumn.ElementStyle>
                    </DataGridCheckBoxColumn>
                    <DataGridTextColumn Header="STT" Binding="{Binding Index}" Width="50" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                <Setter Property="Margin" Value="10,0,0,0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Username" Binding="{Binding Uid}" Width="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="10,0,0,0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Mật khẩu" Binding="{Binding Password}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="10,0,0,0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Cookie" Binding="{Binding Cookie}" Width="250">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="10,0,0,0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Proxy" Binding="{Binding Proxy}" Width="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="10,0,0,0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="*" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="10,0,0,0"/>
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <!-- Text tự động lấy màu tương phản hoặc mặc định -->
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Right Sidebar -->
            <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="10,0,0,0">
                <!-- Action Buttons -->
                <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" Padding="10" Margin="0,0,0,15">
                    <StackPanel>
                        <Button Content="Thêm Tài Khoản" Padding="10" Margin="0,0,0,10" Background="White" BorderBrush="#CCCCCC" Click="BtnImportAccount_Click"/>
                        <Button Content="Import Từ File" Padding="10" Margin="0,0,0,10" Background="White" BorderBrush="#CCCCCC" Click="BtnImportFromFile_Click"/>
                        <Button Content="⚙ Cài đặt" Padding="10" Background="White" BorderBrush="#1877F2" Foreground="#1877F2" Click="BtnSettings_Click"/>
                    </StackPanel>
                </Border>

                <!-- Statistics -->
                <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Thống kê thư mục" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Live" Foreground="#757575"/>
                            <TextBlock Grid.Column="1" Text="{Binding LiveAccounts}" FontWeight="Bold" Foreground="#1877F2"/>
                        </Grid>
                        
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Dead / Spam" Foreground="#757575"/>
                            <TextBlock Grid.Column="1" Text="1" FontWeight="Bold" Foreground="#E53935"/>
                        </Grid>
                        
                        <Separator Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Tổng tài khoản" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Text="{Binding TotalAccounts}" FontWeight="Bold" Foreground="#E53935"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
